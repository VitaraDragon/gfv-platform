{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {"rules": "storage.rules"},
  "functions": {
    "source": "functions",
    "predeploy": ["node functions/scripts/sync-notification-modules.cjs"]
  },
  "emulators": {
    "auth": {"port": 9099},
    "firestore": {"port": 8080},
    "functions": {"port": 5001},
    "storage": {"port": 9199},
    "ui": {"enabled": true}
  },
  "hosting": [
    {
      "target": "default",
      "public": "landing/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/functions/**", "**/docs-sviluppo/**", "**/documentazione-utente/**"],
      "cleanUrls": true,
      "trailingSlash": false
    },
    {
      "target": "app",
      "public": "dist-app",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": false,
      "predeploy": ["npm run build:app"],
      "headers": [
        {
          "source": "**/*.@(html|js|mjs|css|json|md)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/service-worker.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/sw-strategy.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**",
          "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
        }
      ]
    }
  ]
}
