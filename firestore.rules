rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: verifica autenticazione
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: verifica che l'utente appartenga al tenant
    // Supporta sia tenantMemberships (nuovo) che tenantId (deprecato, retrocompatibilità)
    // Legge il documento users dell'utente corrente (ha sempre permesso di lettura)
    function belongsToTenant(tenantId) {
      return isAuthenticated() && (
        // Verifica retrocompatibilità: tenantId deprecato
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId ||
        // Verifica nuova struttura: tenantMemberships - usa keys().hasAny() invece di 'in'
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantMemberships != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantMemberships.keys().hasAny([tenantId]) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantMemberships[tenantId].stato == 'attivo')
      );
    }
    
    // Helper: verifica ruolo utente per un tenant specifico
    // Supporta sia tenantMemberships (nuovo) che ruoli deprecati (retrocompatibilità)
    // @param role - Nome ruolo da verificare
    // @param tenantId - ID tenant (opzionale, se non specificato usa tenantId deprecato)
    function hasRole(role, tenantId) {
      return isAuthenticated() && (
        // Se tenantId è specificato, verifica prima in tenantMemberships - usa keys().hasAny() invece di 'in'
        (tenantId != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantMemberships != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantMemberships.keys().hasAny([tenantId]) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantMemberships[tenantId].stato == 'attivo' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantMemberships[tenantId].ruoli != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantMemberships[tenantId].ruoli.hasAny([role])) ||
        // Retrocompatibilità: se tenantId è specificato ma non in tenantMemberships, verifica tenantId deprecato
        (tenantId != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ruoli != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ruoli.hasAny([role])) ||
        // Retrocompatibilità: verifica ruoli deprecati (se tenantId è null)
        (tenantId == null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ruoli != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ruoli.hasAny([role]))
      );
    }
    
    // Helper: verifica se è Manager o Amministratore per un tenant
    // @param tenantId - ID tenant (opzionale, se non specificato usa tenantId deprecato)
    function isManagerOrAdmin(tenantId) {
      return isAuthenticated() &&
             (hasRole('manager', tenantId) || hasRole('amministratore', tenantId));
    }
    
    // Helper: verifica se è Caposquadra per un tenant
    // @param tenantId - ID tenant (opzionale, se non specificato usa tenantId deprecato)
    function isCaposquadra(tenantId) {
      return isAuthenticated() && hasRole('caposquadra', tenantId);
    }
    
    // Campi profilo che l'utente può aggiornare sul proprio doc (niente autorizzazione / soldi).
    function userSelfProfileKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'nome',
        'cognome',
        'telefono',
        'cellulare',
        'ultimoAccesso',
        'isOnline',
        'lastSeen',
        'notificationPrefs',
        'aggiornatoIl'
      ]);
    }

    // Campi di autorizzazione / contratto: non scrivibili in create «profilo vuoto».
    function userHasAuthOrContractFields(data) {
      return data.keys().hasAny([
        'tenantMemberships',
        'ruoli',
        'ruolo',
        'tenantId',
        'stato',
        'email',
        'creatoDa',
        'invitoId',
        'tipoOperaio',
        'tipoContratto',
        'dataInizioContratto',
        'dataScadenzaContratto',
        'noteContratto',
        'tariffaPersonalizzata'
      ]);
    }

    // Registrazione nuova azienda: tenant creato da questo uid, una sola membership admin.
    function isOwnCompanyRegistrationCreate() {
      return request.resource.data.tenantId is string
        && request.resource.data.tenantId != ''
        && request.resource.data.ruoli is list
        && request.resource.data.ruoli.size() == 1
        && request.resource.data.ruoli[0] == 'amministratore'
        && request.resource.data.stato == 'attivo'
        && request.resource.data.email is string
        && request.auth.token.email != null
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.creatoDa == request.auth.uid
        && !request.resource.data.keys().hasAny([
          'invitoId',
          'tipoOperaio',
          'tipoContratto',
          'dataInizioContratto',
          'dataScadenzaContratto',
          'noteContratto',
          'tariffaPersonalizzata'
        ])
        && request.resource.data.keys().hasAny(['tenantMemberships'])
        && request.resource.data.tenantMemberships.keys().size() == 1
        && request.resource.data.tenantMemberships.keys().hasAny([request.resource.data.tenantId])
        && request.resource.data.tenantMemberships[request.resource.data.tenantId].ruoli is list
        && request.resource.data.tenantMemberships[request.resource.data.tenantId].ruoli.size() == 1
        && request.resource.data.tenantMemberships[request.resource.data.tenantId].ruoli[0] == 'amministratore'
        && request.resource.data.tenantMemberships[request.resource.data.tenantId].stato == 'attivo'
        && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId))
        && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.creatoDa == request.auth.uid;
    }

    // Collection: users (globale)
    // Lettura: proprio doc, oppure utenti del tenant a cui si appartiene (membership o tenantId deprecato).
    // Niente lettura globale per manager/admin (fuga PII tra aziende). Membership solo via callable.
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource.data.tenantId is string && belongsToTenant(resource.data.tenantId))
      );

      // Create: (a) profilo senza campi autorizzativi, oppure (b) registrazione della propria azienda.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && (
          !userHasAuthOrContractFields(request.resource.data) ||
          isOwnCompanyRegistrationCreate()
        );

      // Update: profilo proprio (lista bianca) oppure manager/admin su campi contratto di un ALTRO utente stesso tenant.
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && userSelfProfileKeysOnly()) ||
        (request.auth.uid != userId &&
         resource.data.keys().hasAny(['tenantId']) &&
         resource.data.tenantId != null &&
         isManagerOrAdmin(resource.data.tenantId) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == resource.data.tenantId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'tipoOperaio',
           'tipoContratto',
           'dataInizioContratto',
           'dataScadenzaContratto',
           'noteContratto',
           'tariffaPersonalizzata'
         ]))
      );

      // Delete client vietato (anti ricreazione come admin dopo delete).
      allow delete: if false;
    }
    
    // Campi piano / moduli / prove / Stripe / identità creatore: solo Admin SDK (functions).
    // Lista nera: anagrafica e flag operativi futuri restano scrivibili dal client.
    function toccaCampiFatturazione() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan',
        'piano',
        'modules',
        'moduli',
        'moduleTrials',
        'activeBundles',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'stripeAddons',
        'subscriptionStatus',
        'status',
        'stato',
        'expiryDate',
        'startDate',
        'billingPaymentFailedAt',
        'tonyGuidaOnboardingEndsAt',
        // Identità registrazione (PARTE 1 users): non di fatturazione, ma immutabili dopo create
        'creatoDa',
        'creatoIl'
      ]);
    }

    // Create tenant: solo Free, senza moduli/prove/bundle/Stripe; Tony Guida max ~7 giorni (buffer 8d).
    function tenantCreateIsFreeWithoutBilling() {
      let data = request.resource.data;
      let planOk = (!data.keys().hasAny(['plan']) || data.plan == 'free')
        && (!data.keys().hasAny(['piano']) || data.piano == 'free');
      let modulesOk = (!data.keys().hasAny(['modules'])
          || (data.modules is list && data.modules.size() == 0))
        && (!data.keys().hasAny(['moduli'])
          || (data.moduli is list && data.moduli.size() == 0));
      let noPaidExtras = !data.keys().hasAny([
        'moduleTrials',
        'activeBundles',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'stripeAddons',
        'subscriptionStatus',
        'expiryDate',
        'startDate',
        'billingPaymentFailedAt'
      ]);
      let tonyOk = !data.keys().hasAny(['tonyGuidaOnboardingEndsAt'])
        || (data.tonyGuidaOnboardingEndsAt is timestamp
          && data.tonyGuidaOnboardingEndsAt > request.time
          && data.tonyGuidaOnboardingEndsAt <= request.time + duration.value(8, 'd'));
      return planOk && modulesOk && noPaidExtras && tonyOk;
    }

    // Collection: tenants (globale)
    match /tenants/{tenantId} {
      // Lettura: membri del tenant, oppure creatore durante/completamento registrazione (prima del doc users)
      allow read: if isAuthenticated() && (
        belongsToTenant(tenantId) ||
        (resource.data.keys().hasAny(['creatoDa']) && resource.data.creatoDa == request.auth.uid)
      );
      
      // Scrittura:
      // - Manager/admin del tenant possono creare (es. Impostazioni se manca il doc) solo Free senza billing;
      //   creatoDa assente oppure = uid (niente creatore altrui → scalata admin via PARTE 1 users).
      // - Utente in registrazione (niente doc users) se creatoDa == uid, stesso vincolo Free
      allow create: if isAuthenticated()
        && tenantCreateIsFreeWithoutBilling()
        && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           isManagerOrAdmin(tenantId) &&
           belongsToTenant(tenantId) &&
           (!request.resource.data.keys().hasAny(['creatoDa']) ||
            request.resource.data.creatoDa == request.auth.uid)) ||
          (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           request.resource.data.creatoDa == request.auth.uid)
        );
      
      // Aggiornamento: manager/admin; campi fatturazione/piano/moduli/creato* solo dalle functions.
      allow update: if isAuthenticated()
        && isManagerOrAdmin(tenantId)
        && belongsToTenant(tenantId)
        && !toccaCampiFatturazione();

      // Delete client vietato: evita reset moduleTrials / tonyGuidaOnboardingEndsAt e ricreazione
      // con creatoDa di un complice. Solo Admin SDK (fuori dalle rules).
      allow delete: if false;
    }
    
    // Collection: inviti (globale)
    // Lettura client: solo manager/admin del tenant dell'invito (lista Gestione utenti).
    // Registrazione non autenticata: callable getInvitoPubblico (Admin lookup per token).
    // Non si può esprimere in rules «list solo se conosci il token» — query token== richiede list.
    match /inviti/{invitoId} {
      allow get, list: if isAuthenticated()
        && resource.data.tenantId is string
        && resource.data.tenantId != ''
        && belongsToTenant(resource.data.tenantId)
        && isManagerOrAdmin(resource.data.tenantId);
      
      // Creazione: solo manager/amministratore del tenant indicato, a proprio nome (anti-abuso / spam).
      // Allineato a invito-service-standalone.js e gestisci-utenti-standalone.html (campi obbligatori).
      allow create: if isAuthenticated() &&
        request.resource.data.tenantId is string &&
        request.resource.data.tenantId != '' &&
        request.resource.data.email is string &&
        request.resource.data.token is string &&
        request.resource.data.stato == 'invitato' &&
        request.resource.data.inviatoDa == request.auth.uid &&
        belongsToTenant(request.resource.data.tenantId) &&
        isManagerOrAdmin(request.resource.data.tenantId);
      
      // Aggiornamento: solo manager/admin; campi identità invito immutabili; unica transizione client: invitato → annullato.
      // Accettazione invito: solo callable accettaInvito (Admin SDK).
      allow update: if isAuthenticated()
        && resource.data.tenantId != null
        && belongsToTenant(resource.data.tenantId)
        && isManagerOrAdmin(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.inviatoDa == resource.data.inviatoDa
        && request.resource.data.token == resource.data.token
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato'])
        && resource.data.stato == 'invitato'
        && request.resource.data.stato == 'annullato';
      
      // Eliminazione: solo manager/admin del tenant dell'invito
      allow delete: if isAuthenticated() && 
        resource.data.tenantId != null &&
        belongsToTenant(resource.data.tenantId) &&
        isManagerOrAdmin(resource.data.tenantId);
    }
    
    // Dati tenant (multi-tenant) - Regola generica per tutte le subcollection
    // NOTA: Le regole specifiche hanno priorità, questa è solo un fallback
    // DISABILITATA per evitare conflitti con onSnapshot
    // match /tenants/{tenantId}/{document=**} {
    //   allow read: if isAuthenticated() && belongsToTenant(tenantId);
    // }
    
    // Regole specifiche per collection Conto Terzi
    
    // Collection: clienti
    match /tenants/{tenantId}/clienti/{clienteId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }
    
    // Collection: tariffe
    match /tenants/{tenantId}/tariffe/{tariffaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }
    
    // Collection: preventivi
    match /tenants/{tenantId}/preventivi/{preventivoId} {
      // Lettura/scrittura: solo tenant autenticato (accettazione cliente via Cloud Function getPreventivoPubblico / aggiornaStatoPreventivoPubblico)
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      
      // Creazione: solo manager/admin autenticati
      allow create: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
      
      // Aggiornamento: solo manager/admin (stato da link pubblico aggiornato lato server)
      allow update: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
      
      // Eliminazione: solo manager/admin autenticati
      allow delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }
    
    // Collection: poderi-clienti
    match /tenants/{tenantId}/poderi-clienti/{podereId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: prodotti (modulo Prodotti e Magazzino)
    match /tenants/{tenantId}/prodotti/{prodottoId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);

      // Righe di coltura della scheda. Le scrive solo la Cloud Function.
      match /schedaImpieghi/{rigaId} {
        allow read: if isAuthenticated() && belongsToTenant(tenantId);
        allow write: if false;
      }
    }

    // Collection: movimentiMagazzino (modulo Prodotti e Magazzino)
    match /tenants/{tenantId}/movimentiMagazzino/{movimentoId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: documentiAcquisiti (Tony Occhi — archivio originali Magazzino)
    match /tenants/{tenantId}/documentiAcquisiti/{sessionId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }
    
    // Collection: terreni (già esistente, ma assicuriamoci che funzioni)
    match /tenants/{tenantId}/terreni/{terrenoId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Vendemmia Meccanica — calcoli salvati
    match /tenants/{tenantId}/calcoli-vendemmia-meccanica/{calcoloId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Vendemmia Meccanica — spese bilancio servizio
    match /tenants/{tenantId}/spese-vendemmia-meccanica/{spesaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: poderi (aziendali, non clienti)
    match /tenants/{tenantId}/poderi/{podereId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Cache meteo (scritta solo da Cloud Functions — admin SDK; include sottocollezione terreni)
    match /tenants/{tenantId}/meteoCache/{document=**} {
      allow read, write: if false;
    }

    // Cache context Tony (solo Cloud Functions — admin SDK)
    match /tenants/{tenantId}/tonyContextCache/{document=**} {
      allow read, write: if false;
    }

    // Contatore giornaliero Tony Guida onboarding piano Free (solo Cloud Functions — admin SDK)
    match /tenants/{tenantId}/tonyOnboardingQuota/{document=**} {
      allow read, write: if false;
    }

    // Collection: liste (dati personalizzati, es. colture)
    match /tenants/{tenantId}/liste/{listaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: impostazioni (impostazioni tenant, es. coefficienti morfologia, tariffe operai)
    match /tenants/{tenantId}/impostazioni/{impostazioneId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: categorie (unificata per lavori e attrezzi)
    match /tenants/{tenantId}/categorie/{categoriaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: tipiLavoro (tipi di lavoro gerarchici)
    match /tenants/{tenantId}/tipiLavoro/{tipoId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: colture (colture unificate)
    match /tenants/{tenantId}/colture/{colturaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: categorieLavori (vecchia collezione, per migrazione)
    match /tenants/{tenantId}/categorieLavori/{categoriaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: categorieAttrezzi (vecchia collezione, per migrazione)
    match /tenants/{tenantId}/categorieAttrezzi/{categoriaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }
    
    // Collection: lavori (già esistente)
    match /tenants/{tenantId}/lavori/{lavoroId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      
      // Creazione ed eliminazione: solo manager/admin
      allow create, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
      
      // Aggiornamento: manager/admin possono aggiornare tutto
      // Caposquadra può aggiornare solo campi di progresso e stato per lavori assegnati a lui
      // Operaio può segnare come completato lavori autonomi assegnati a lui
      allow update: if isAuthenticated() && belongsToTenant(tenantId) && (
        // Manager/Admin: possono aggiornare tutto
        isManagerOrAdmin(tenantId) ||
        // Caposquadra: può aggiornare solo campi di progresso e stato per lavori di squadra assegnati a lui
        (isCaposquadra(tenantId) && 
         // Verifica che il lavoro sia assegnato a questo caposquadra (lavoro di squadra, non autonomo)
         resource.data.caposquadraId == request.auth.uid &&
         (!('operaioId' in resource.data) || resource.data.operaioId == null) &&
         // Permetti aggiornamento solo di questi campi specifici
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'superficieTotaleLavorata',
           'superficieRimanente',
           'percentualeCompletamento',
           'percentualeCompletamentoTracciata',
           'giorniEffettivi',
           'statoProgresso',
           'stato',
           'sospensioneCausa',
           'sospensioneIl',
           'note',
           'completatoDa',
           'completatoIl',
           'completamentoParziale',
           'aggiornatoIl'
         ]) &&
         // Verifica che lo stato sia valido (solo transizioni permesse)
         (request.resource.data.stato == 'in_corso' ||
          request.resource.data.stato == 'completato' ||
          request.resource.data.stato == 'completato_da_approvare' ||
          request.resource.data.stato == 'sospeso' ||
          (request.resource.data.stato == 'assegnato' && resource.data.stato == 'sospeso') ||
          request.resource.data.stato == resource.data.stato)) ||
        // Operaio: può segnare come completato lavori autonomi assegnati a lui
        // E può aggiornare progressi quando traccia zone lavorate
        (hasRole('operaio', tenantId) &&
         // Verifica che il lavoro sia autonomo assegnato a questo operaio
         resource.data.operaioId == request.auth.uid &&
         (!('caposquadraId' in resource.data) || resource.data.caposquadraId == null) &&
         // Permetti aggiornamento solo di questi campi specifici
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'stato',
           'percentualeCompletamentoTracciata',
           'superficieTotaleLavorata',
           'superficieRimanente',
           'percentualeCompletamento',
           'giorniEffettivi',
           'statoProgresso',
           'sospensioneCausa',
           'sospensioneIl',
           'note',
           'completatoDa',
           'completatoIl',
           'completamentoParziale',
           'aggiornatoIl'
         ]) &&
         // Verifica che lo stato sia valido (solo transizioni permesse per operai)
         (request.resource.data.stato == 'completato_da_approvare' ||
          request.resource.data.stato == 'in_corso' ||
          request.resource.data.stato == 'sospeso' ||
          (request.resource.data.stato == 'assegnato' && resource.data.stato == 'sospeso') ||
          request.resource.data.stato == resource.data.stato))
      );
    }
    
    // Collection: attivita (già esistente)
    match /tenants/{tenantId}/attivita/{attivitaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId);
    }

    // Collection: squadre (Manodopera)
    match /tenants/{tenantId}/squadre/{squadraId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Profili manodopera (skill dichiarate / calcolate — scheda operaio)
    match /tenants/{tenantId}/profiliManodopera/{userId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
      allow delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Assenze operai (giornata intera — segnalazione caposquadra, conferma manager)
    match /tenants/{tenantId}/assenzeOperai/{assenzaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create: if isAuthenticated() && belongsToTenant(tenantId) && (
        isManagerOrAdmin(tenantId) ||
        (isCaposquadra(tenantId) && request.resource.data.stato == 'segnalata')
      );
      allow update: if isAuthenticated() && belongsToTenant(tenantId) && (
        isManagerOrAdmin(tenantId) ||
        (isCaposquadra(tenantId) &&
         resource.data.stato == 'segnalata' &&
         request.resource.data.stato == 'segnalata')
      );
      allow delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: guasti. Regola comunicazioni: chi segnala corregge/ritira finché il manager non decide.
    match /tenants/{tenantId}/guasti/{guastoId} {
      allow read: if belongsToTenant(tenantId);
      allow create: if belongsToTenant(tenantId)
                    && request.resource.data.segnalatoDa == request.auth.uid
                    && request.resource.data.stato == 'in-attesa';
      allow update: if belongsToTenant(tenantId) && (
        isManagerOrAdmin(tenantId) ||
        ( resource.data.segnalatoDa == request.auth.uid
          && (!('stato' in resource.data) || resource.data.stato == 'in-attesa')  // il manager non ha ancora deciso (assente = dato vecchio)
          && request.resource.data.stato in ['in-attesa', 'annullato', 'risolto']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'stato','dettagli','noteRisoluzione','costoRiparazione','risolto','risoltoDa','risoltoIl',
               'annullatoDa','annullatoIl','storico','noteAggiuntive','updatedAt']) )
      );
      allow delete: if belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: macchine (Parco Macchine)
    match /tenants/{tenantId}/macchine/{macchinaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
      // Manager: pieno controllo. Caposquadra/operaio: solo chiavi stato e updatedAt,
      // e solo liberazione oppure segnalazione guasto.
      allow update: if isAuthenticated() && belongsToTenant(tenantId) && (
        isManagerOrAdmin(tenantId) ||
        (
          (isCaposquadra(tenantId) || hasRole('operaio', tenantId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'updatedAt']) &&
          (
            request.resource.data.stato == 'disponibile' ||
            request.resource.data.stato == 'guasto' ||
            request.resource.data.stato == 'guasto-lavoro-in-corso' ||
            // ripristino dopo annullo/chiusura del guasto: torna in uso solo se era fermo per guasto
            (request.resource.data.stato == 'in_uso' &&
             resource.data.stato in ['guasto', 'guasto-lavoro-in-corso'])
          )
        )
      );
    }

    // Collection: vigneti (Modulo Vigneto)
    match /tenants/{tenantId}/vigneti/{vignetoId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Subcollection: vendemmie (sotto vigneti)
    match /tenants/{tenantId}/vigneti/{vignetoId}/vendemmie/{vendemmiaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Subcollection: potature (sotto vigneti)
    match /tenants/{tenantId}/vigneti/{vignetoId}/potature/{potaturaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Subcollection: trattamenti (sotto vigneti)
    match /tenants/{tenantId}/vigneti/{vignetoId}/trattamenti/{trattamentoId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: statistiche_vigneto (aggregazioni pre-calcolate per performance)
    // NOTA: Permettiamo creazione/aggiornamento a tutti gli utenti autenticati del tenant
    // perché le aggregazioni sono solo cache e vengono calcolate automaticamente
    // La sicurezza è garantita dal fatto che contengono solo dati aggregati già accessibili
    match /tenants/{tenantId}/statistiche_vigneto/{statsId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update: if isAuthenticated() && belongsToTenant(tenantId);
      allow delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: statistiche_frutteto (aggregazioni pre-calcolate per performance)
    match /tenants/{tenantId}/statistiche_frutteto/{statsId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update: if isAuthenticated() && belongsToTenant(tenantId);
      allow delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: frutteti (Modulo Frutteto)
    match /tenants/{tenantId}/frutteti/{fruttetoId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Subcollection: raccolte (sotto frutteti)
    match /tenants/{tenantId}/frutteti/{fruttetoId}/raccolte/{raccoltaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Subcollection: potature (sotto frutteti)
    match /tenants/{tenantId}/frutteti/{fruttetoId}/potature/{potaturaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Subcollection: trattamenti (sotto frutteti)
    match /tenants/{tenantId}/frutteti/{fruttetoId}/trattamenti/{trattamentoId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: seminativi (Modulo Seminativo — campagne, non impianto permanente)
    match /tenants/{tenantId}/seminativi/{campagnaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: semineSeminativo (eventi di semina collegati a una campagna)
    match /tenants/{tenantId}/semineSeminativo/{seminaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: trattamentiSeminativo (prodotto e dose su un lavoro o un'attività di diario)
    match /tenants/{tenantId}/trattamentiSeminativo/{trattamentoId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: raccolteSeminativo (quintali di mietitura su un lavoro o un'attività di diario)
    match /tenants/{tenantId}/raccolteSeminativo/{raccoltaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: raccolteFrutta (raccolte frutta standalone, non sotto frutteti)
    match /tenants/{tenantId}/raccolteFrutta/{raccoltaId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: pianificazioni-impianti (pianificazioni nuovi impianti)
    match /tenants/{tenantId}/pianificazioni-impianti/{pianificazioneId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Subcollection: oreOperai (sotto lavori)
    // Deploy di questo blocco: lo fa Pier a mano con npm run deploy:rules,
    // solo dopo che la nuova interfaccia (modifica, sovrapposizioni, correzione) è online e verificata.
    // Non deployare insieme a questo commit. Nessun deploy di Cloud Functions.
    // Il controllo di sovrapposizione NON sta nelle Rules: non possono leggere le altre righe del giorno.
    // Il seed del simulatore scrive lavori.caposquadraId = uid Auth del caposquadra (fase 06/07):
    // la condizione caposquadraId == request.auth.uid coincide con gli e2e.
    match /tenants/{tenantId}/lavori/{lavoroId}/oreOperai/{oraId} {
      function oreChiaviProprietarioOk() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'data', 'orarioInizio', 'orarioFine', 'pauseMinuti', 'oreNette', 'note',
          'macchinaId', 'attrezzoId', 'oreMacchina', 'posizioneRilevamento',
          'stato', 'rifiutatoDa', 'rifiutatoIl', 'motivoRifiuto',
          'modificatoDa', 'modificatoIl', 'storicoModifiche'
        ]);
      }

      function caposquadraPuoAggiornareOraOperaio() {
        let lavoro = get(/databases/$(database)/documents/tenants/$(tenantId)/lavori/$(lavoroId)).data;
        return isCaposquadra(tenantId)
          && lavoro.keys().hasAny(['caposquadraId'])
          && lavoro.caposquadraId == request.auth.uid
          && resource.data.operaioId != request.auth.uid
          && (!lavoro.keys().hasAny(['operaioId']) || lavoro.operaioId == null || lavoro.operaioId == '');
      }

      allow read: if isAuthenticated() && belongsToTenant(tenantId);

      allow create: if isAuthenticated() && belongsToTenant(tenantId)
        && request.resource.data.operaioId == request.auth.uid
        && request.resource.data.stato == 'da_validare'
        && request.resource.data.lavoroId == lavoroId;

      allow update: if isAuthenticated() && belongsToTenant(tenantId)
        && request.resource.data.get('operaioId', '') == resource.data.get('operaioId', '')
        && request.resource.data.get('lavoroId', '') == resource.data.get('lavoroId', '')
        && (
          (
            resource.data.operaioId == request.auth.uid
            && (resource.data.stato == 'da_validare' || resource.data.stato == 'rifiutate')
            && request.resource.data.stato == 'da_validare'
            && oreChiaviProprietarioOk()
          )
          || isManagerOrAdmin(tenantId)
          || caposquadraPuoAggiornareOraOperaio()
        );

      allow delete: if isAuthenticated() && belongsToTenant(tenantId) && (
        (
          resource.data.operaioId == request.auth.uid
          && (resource.data.stato == 'da_validare' || resource.data.stato == 'rifiutate')
        )
        || isManagerOrAdmin(tenantId)
      );
    }

    // Subcollection: zoneLavorate (sotto lavori)
    match /tenants/{tenantId}/lavori/{lavoroId}/zoneLavorate/{zonaId} {
      function puoCreareZonaCampo() {
        let lavoro = get(/databases/$(database)/documents/tenants/$(tenantId)/lavori/$(lavoroId)).data;
        let capoId = lavoro.get('caposquadraId', null);
        let operaioId = lavoro.get('operaioId', null);
        let sostitutoId = lavoro.get('assenzaSostitutoOperaioId', null);
        return (capoId != null && capoId != '' && capoId == request.auth.uid && isCaposquadra(tenantId))
          || ((capoId == null || capoId == '') && hasRole('operaio', tenantId)
              && ((operaioId != null && operaioId == request.auth.uid)
                  || (sostitutoId != null && sostitutoId == request.auth.uid)));
      }
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create: if isAuthenticated() && belongsToTenant(tenantId)
        && (isManagerOrAdmin(tenantId) || puoCreareZonaCampo());
      // Update: proprietario della zona, caposquadra del lavoro padre, manager/admin.
      // Il sostituto modifica solo le zone sue (è il proprietario: handleSalvaZona scrive operaioId = uid).
      // operaioId e caposquadraId della zona non si possono cambiare, aggiungere o togliere.
      function puoAggiornareZona() {
        let capoLavoro = get(/databases/$(database)/documents/tenants/$(tenantId)/lavori/$(lavoroId)).data.get('caposquadraId', null);
        return resource.data.get('operaioId', null) == request.auth.uid
          || resource.data.get('caposquadraId', null) == request.auth.uid
          || isManagerOrAdmin(tenantId)
          || (capoLavoro != null && capoLavoro == request.auth.uid && isCaposquadra(tenantId));
      }
      allow update: if isAuthenticated() && belongsToTenant(tenantId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['operaioId', 'caposquadraId'])
        && puoAggiornareZona();
      // Delete: solo il proprietario (operaioId o caposquadraId) o manager/admin possono eliminare
      allow delete: if isAuthenticated() && belongsToTenant(tenantId) && (
        resource.data.operaioId == request.auth.uid ||
        resource.data.caposquadraId == request.auth.uid ||
        isManagerOrAdmin(tenantId)
      );
    }

    // Subcollection: manutenzioni (sotto macchine)
    match /tenants/{tenantId}/macchine/{macchinaId}/manutenzioni/{manutenzioneId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      allow create, update, delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Collection: comunicazioni (comunicazioni caposquadra -> operai)
    match /tenants/{tenantId}/comunicazioni/{comunicazioneId} {
      // Lettura: operai e caposquadra del tenant possono leggere comunicazioni dove sono destinatari
      // NOTA: Il filtro per destinatari viene fatto lato client, qui permettiamo lettura a tutti gli utenti del tenant
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      
      // Creazione: solo caposquadra e manager/admin
      allow create: if isAuthenticated() && belongsToTenant(tenantId) && 
                     (hasRole('caposquadra', tenantId) || isManagerOrAdmin(tenantId));
      
      // Aggiornamento: caposquadra/manager/admin possono aggiornare tutto, operai solo il campo conferme
      allow update: if isAuthenticated() && belongsToTenant(tenantId) && (
        // Caposquadra/manager/admin: possono aggiornare tutto
        (hasRole('caposquadra', tenantId) || isManagerOrAdmin(tenantId)) ||
        // Operai: possono aggiornare solo il campo conferme (per confermare ricezione)
        (hasRole('operaio', tenantId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conferme']))
      );
      
      // Eliminazione: solo manager/admin
      allow delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    match /tenants/{tenantId}/notificationEvents/{eventId} {
      allow read: if isAuthenticated() && belongsToTenant(tenantId) &&
        resource.data.keys().hasAny(['recipientUserIds']) &&
        resource.data.recipientUserIds is list &&
        resource.data.recipientUserIds.hasAny([request.auth.uid]);
      allow create, delete: if false;
      allow update: if isAuthenticated() && belongsToTenant(tenantId)
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.recipientUserId == resource.data.recipientUserId
        && request.resource.data.type == resource.data.type
        && request.resource.data.status == 'seen'
        && resource.data.status in ['pending', 'queued', 'sent']
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'seenAt', 'seenBy', 'updatedAt']);
    }
  }
}

