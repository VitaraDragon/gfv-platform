rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper: verifica autenticazione
    function isAuthenticated() {
      return request.auth != null;
    }

    // Doc utente corrente (Firestore) — stessa logica di firestore.rules
    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function hasMembershipKey(tenantId) {
      return userData().keys().hasAny(['tenantMemberships']) &&
             userData().tenantMemberships.keys().hasAny([tenantId]);
    }

    // Membership autorevole: se esiste tenantMemberships[t] conta solo stato == attivo.
    // Altrimenti tenantId deprecato + non disattivato (allineato a firestore.rules).
    function legacyStatoOk() {
      return !userData().keys().hasAny(['stato']) || userData().stato != 'disattivato';
    }

    function belongsToTenant(tenantId) {
      return isAuthenticated() && (
        (hasMembershipKey(tenantId) &&
         userData().tenantMemberships[tenantId].stato == 'attivo') ||
        (!hasMembershipKey(tenantId) &&
         userData().tenantId == tenantId &&
         legacyStatoOk())
      );
    }

    function hasRole(role, tenantId) {
      return isAuthenticated() && (
        (hasMembershipKey(tenantId) &&
         userData().tenantMemberships[tenantId].stato == 'attivo' &&
         userData().tenantMemberships[tenantId].ruoli != null &&
         userData().tenantMemberships[tenantId].ruoli.hasAny([role])) ||
        (!hasMembershipKey(tenantId) &&
         userData().tenantId == tenantId &&
         legacyStatoOk() &&
         userData().ruoli != null &&
         userData().ruoli.hasAny([role]))
      );
    }

    function isManagerOrAdmin(tenantId) {
      return hasRole('manager', tenantId) || hasRole('amministratore', tenantId);
    }
    
    // Regola per loghi aziendali: tenants/{tenantId}/logo_*.{ext}
    match /tenants/{tenantId}/{logoFileName} {
      // Verifica che il file sia un logo (nome inizia con "logo_")
      function isLogoFile() {
        return logoFileName.matches('logo_.*');
      }
      
      // Lettura: utenti autenticati attivi del tenant
      allow read: if isAuthenticated() && belongsToTenant(tenantId);
      
      // Scrittura: solo manager/amministratore del tenant
      allow create, update: if isAuthenticated() &&
                      belongsToTenant(tenantId) &&
                      isManagerOrAdmin(tenantId) &&
                      isLogoFile() &&
                      request.resource.size < 2 * 1024 * 1024 && // Max 2MB
                      (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/octet-stream');
      
      // Eliminazione: manager/amministratore del tenant
      allow delete: if isAuthenticated() && belongsToTenant(tenantId) && isManagerOrAdmin(tenantId);
    }

    // Tony Occhi — originali documenti acquisiti (foto/PDF)
    // Path: tenants/{tenantId}/documentiAcquisiti/{sessionId}/page-N.ext
    match /tenants/{tenantId}/documentiAcquisiti/{sessionId}/{fileName} {
      function isDocumentPageFile() {
        return fileName.matches('page-[0-9]+\\.(jpg|jpeg|png|webp|pdf)');
      }
      function isAllowedDocContentType() {
        return request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf';
      }

      allow read: if isAuthenticated() && belongsToTenant(tenantId);

      allow create, update: if isAuthenticated()
        && belongsToTenant(tenantId)
        && isDocumentPageFile()
        && isAllowedDocContentType()
        && request.resource.size < 12 * 1024 * 1024;

      allow delete: if isAuthenticated() && belongsToTenant(tenantId);
    }
    
    // Blocca tutto il resto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
